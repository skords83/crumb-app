# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dein_sicheres_passwort
POSTGRES_DB=crumb_db
JWT_SECRET=erzeuge_mit_openssl_rand_hex_32

# Registrierung bleibt ohne Code geschlossen. Erzeugen: openssl rand -hex 32
REGISTRATION_INVITE_CODE=

# Web Push: cd api && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@deine-domain.com

# Passwortreset per E-Mail (587/STARTTLS oder 465/SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CORS & URLs
ALLOWED_ORIGIN=https://deine-domain.com
NEXT_PUBLIC_API_URL=https://deine-domain.com/api
BASE_URL=https://deine-domain.com
FRONTEND_URL=https://deine-domain.com
